# ---------------------------------------------------------------------------
# JobFlow AI — backend environment template.
#
# This file documents EVERY variable the app reads in production. Copy to .env
# locally; on Render, set these in the dashboard (or via render.yaml).
#
# PRODUCTION VALUES ARE SHOWN. The defaults are deliberately NOT safe for
# production — see the comments marked [PROD] for what must change.
# ---------------------------------------------------------------------------

APP_NAME="JobFlow AI API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# Local dev: PostgreSQL 16 on :5433 (see ./scripts/db.sh).
# [PROD] On Render, delete DB_HOST/PORT/DATABASE/USERNAME/PASSWORD and set
#        DATABASE_URL — Render injects it automatically when the database is
#        linked to the service. config/database.php reads either name.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=jobflow_api_development
DB_USERNAME=jobflow
DB_PASSWORD=jobflow_local_dev
# DB_URL=
# DATABASE_URL=

# --- Session (Sanctum SPA cookie auth) ----------------------------------
# [PROD] SESSION_SECURE_COOKIE=true  — HTTPS only.
# [PROD] SESSION_SAME_SITE=none     — REQUIRED. The app (vercel.app) and the
#       API (onrender.com) are DIFFERENT sites, so "lax" means the browser
#       withholds the session cookie on every API call and the user appears to
#       log in and then gets 401 on everything. "none" is only safe together
#       with SESSION_SECURE_COOKIE=true.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Host-only cookies. Do NOT set this to "localhost": that emits
# "Domain=localhost", a single-label domain browsers may reject.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# --- Storage ------------------------------------------------------------
# [PROD] "local" is PRIVATE (storage/app/private) and is correct for a first
#       deploy, but Render's filesystem is EPHEMERAL: uploaded PDFs, images and
#       resumes are lost on every redeploy. Move to the "r2" disk before this
#       matters — see DEPLOYMENT.md §"Storage".
FILESYSTEM_DISK=local

# --- CORS / Sanctum -----------------------------------------------------
# [PROD] Both must list the deployed frontend origin. A wildcard is not an
#       option: it is rejected alongside credentials=true, and rightly so.
#       The Vercel preview domain changes per deployment, so add it too.
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000

# --- Mail ----------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@jobflow.ai"
MAIL_FROM_NAME="${APP_NAME}"

# --- AI ------------------------------------------------------------------
# [PROD] AI_PROVIDER=gemini and GEMINI_MODEL=gemini-2.0-flash (free tier).
#       Keys are NEVER hardcoded — set them in the Render dashboard.
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30

# Vision OCR for image captures and text-layer-less PDFs. Resolves to "fake"
# only in the test suite; "fake" returns a placeholder string and must never
# be used outside tests.
OCR_PROVIDER=gemini
OCR_MODEL=gemini-flash-lite-latest
OCR_TIMEOUT=60

# --- Cloudflare R2 (optional, not yet in use) ---------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto

