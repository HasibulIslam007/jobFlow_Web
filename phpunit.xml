<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests run against the real engine (PostgreSQL): jsonb, tsvector and
             pgvector behaviour cannot be validated on SQLite. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5433"/>
        <env name="DB_DATABASE" value="jobflow_api_test"/>
        <env name="DB_USERNAME" value="jobflow"/>
        <env name="DB_PASSWORD" value="jobflow_local_dev"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Tests must never reach a real AI provider: it costs money, is slow
             and makes results depend on a third party being healthy. Force the
             fake provider globally; individual tests that need to assert AI
             output still bind a configured FakeAIProvider explicitly. -->
        <env name="AI_PROVIDER" value="fake"/>
        <env name="AI_API_KEY" value=""/>
        <env name="GEMINI_API_KEY" value=""/>
        <env name="OPENAI_API_KEY" value=""/>
        <!-- Image capture must never reach a real vision model in tests. -->
        <env name="OCR_PROVIDER" value="fake"/>
        <env name="OCR_API_KEY" value=""/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
